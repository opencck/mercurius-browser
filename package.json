{
    "name": "mercurius-browser",
    "private": true,
    "description": "The browser of the Mercurius agent: Chromium with a window under puppeteer-core behind a small Fastify API",
    "license": "MIT",
    "type": "module",
    "main": "dist/src/server.js",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "tsc && node --test dist/test/*.test.js",
        "start": "node dist/src/server.js",
        "check": "npm run typecheck && npm run lint && npm test"
    },
    "dependencies": {
        "fastify": "4.28.1",
        "puppeteer-core": "23.11.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.5",
        "eslint": "10.15.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    }
}
